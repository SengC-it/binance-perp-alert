# 复制为 .env 并填入真实值。永远不要把 .env 提交到版本库。

# 币安 U 本位合约 API —— 必须是【只读】Key，并开启 IP 白名单。
# 权限只勾选"允许读取"，绝对不要勾选"允许交易"或"允许提现"。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- 投递通道 ----
# 两种通道可以同时启用，按 config.yaml 的 notify.channels 做分级路由。

# 1) 邮件（SMTP）
# 格式：mailtos://GMAIL用户名:应用专用密码@gmail.com?to=收件邮箱
#
# 【最容易填错的一点】这里的"GMAIL用户名"是 @ 前面的部分，不要带 @gmail.com。
#   正确  mailtos://sengcit:abcdefghijklmnop@gmail.com?to=recv@x.com
#   错误  mailtos://sengcit@gmail.com:abcdefghijklmnop@gmail.com?to=recv@x.com   ← 解析失败
#
# 说明（以下均为 Apprise 1.13.1 实测结论，非推测）：
#   1. Gmail 应用专用密码需要先在 Google 账号开启"两步验证"，再生成 16 位应用专用密码。
#      地址：https://myaccount.google.com/apppasswords
#   2. 应用专用密码显示时带空格（形如 abcd efgh ijkl mnop），填写时要【去掉空格】。
#   3. mailtos:// 与 mailto:// 对 Gmail 完全等价，都会被解析为
#      smtp.gmail.com:587 + STARTTLS（Apprise 对 gmail.com 有内置映射）。
#      推荐用 mailtos://。网上常见的"465/SSL"说法不适用于这里。
#   4. 收件人可以多个，用逗号分隔：?to=a@x.com,b@y.com
#   5. 若密码里含 @ : / 等特殊字符，改用斜杠分隔的写法（Gmail 应用密码一般不需要）：
#      mailtos://sengcit@gmail.com/abcdefghijklmnop@gmail.com?to=recv@x.com
APPRISE_EMAIL_URL=

# 2) Telegram
# 格式：tgram://<bot_token>/<chat_id>
# 获取步骤：
#   1. 在 Telegram 里找 @BotFather，发送 /newbot，拿到 bot token（形如 123456:ABC-DEF...）
#   2. 给你的 bot 发一条消息，然后访问
#      https://api.telegram.org/bot<token>/getUpdates
#      在返回 JSON 里找 "chat":{"id":...}，那就是 chat_id
#   3. 群聊的 chat_id 是负数，直接原样填入即可
APPRISE_TELEGRAM_URL=

# 兼容旧配置：只填这一个时会作为单一通道使用（等价于 email）。
APPRISE_URL=
